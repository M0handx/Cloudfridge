# Copy to .env for local development.
DATABASE_URL=postgres://cf_dev:cf_dev@127.0.0.1:5432/cloudfridge_dev
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# One worker is easier to debug locally. On AWS, leave unset: one worker per vCPU.
WORKERS=1
# off | verify. Defaults to verify when NODE_ENV=production.
DB_SSL=off
