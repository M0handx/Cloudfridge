{
  "name": "cloudfridge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node-pg-migrate up -m migrations",
    "migrate:dev": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "bootstrap-db": "node scripts/bootstrap-db.js",
    "pretest": "node --env-file=.env.test ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "test": "node --env-file=.env.test --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  }
}
